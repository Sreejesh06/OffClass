# Server Environment Variables

# The connection pooler URL (e.g., PgBouncer) used for standard queries
# Example format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cryptid?pgbouncer=true"

# The direct connection to the database, used for migrations
# Example format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cryptid"

# Redis connection string for leaderboards and rate limiting
REDIS_URL="redis://localhost:6379"

# API Port
PORT="3000"
