# Server Environment Variables

# The connection pooler URL (e.g., PgBouncer) used for standard queries
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cryptid?pgbouncer=true"

# The direct connection to the database, used for migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cryptid"

# Redis connection string for leaderboards, queues, and rate limiting
REDIS_URL="redis://localhost:6379"

# JWT secret for access/refresh tokens
JWT_SECRET="change_me_in_production"

# API Port
PORT="3000"

# MinIO (S3-compatible object storage for certificate uploads)
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="cryptid-certs"

# HackTheBox department-level App Token
# Generate at: https://app.hackthebox.com/profile/settings
HTB_APP_TOKEN=""
