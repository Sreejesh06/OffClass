generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User representation tied to Houses
model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  name             String
  house            House
  role             Role           @default(STUDENT)
  points           Int            @default(0)
  
  bio              String?
  githubHandle     String?
  codeforcesHandle String?
  htbHandle        String?

  refreshTokens        RefreshToken[]
  leaderboardSnapshots LeaderboardSnapshot[]
  platformSyncStates   PlatformSyncState[]
  certificates         Certificate[]

  totpSecret           String?
  isTotpEnabled        Boolean        @default(false)

  createdAt            DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String   @unique
  familyId    String   // Connects rotated tokens together
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model LeaderboardSnapshot {
  id           String   @id @default(uuid())
  termName     String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  house        House
  points       Int
  rankInHouse  Int
  rankOverall  Int
  snapshotDate DateTime @default(now())
}

model PlatformSyncState {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform     Platform
  snapshotData Json
  updatedAt    DateTime @updatedAt

  @@unique([userId, platform])
}

model Certificate {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileKey   String   @unique
  mimeType  String
  status    String   @default("PENDING_VERIFICATION")
  createdAt DateTime @default(now())
}

enum Platform {
  GITHUB
  CODEFORCES
  LEETCODE
  HTB
  THM
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum House {
  RED
  BLUE
  GREEN
  PURPLE
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  PUBLISHED
  REJECTED
}

enum ComplaintCategory {
  GRADING
  HARASSMENT
  PLATFORM_BUG
  OTHER
}

model Complaint {
  id           String            @id @default(uuid())
  trackingCode String            @unique
  category     ComplaintCategory
  content      String
  status       ComplaintStatus   @default(SUBMITTED)
  reportedDay  String            // YYYY-MM-DD
  adminNotes   String?
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}
