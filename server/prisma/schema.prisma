generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String
  name             String
  house            House
  role             Role           @default(STUDENT)
  points           Int            @default(0)

  bio              String?
  avatar           String?
  workDomain       String?
  skills           String[]

  refreshTokens        RefreshToken[]
  leaderboardSnapshots LeaderboardSnapshot[]
  profileLinks         ProfileLink[]
  profileSyncs         ProfileSync[]
  certificates         Certificate[]
  pointsTransactions   PointsTransaction[]
  redemptions          Redemption[]
  badges               UserBadge[]
  houseTransferRequests HouseTransferRequest[]
  achievements         Achievement[]
  workExperiences      WorkExperience[]
  postedOpportunities  Opportunity[]         @relation("PostedOpportunities")
  opportunityBookmarks OpportunityBookmark[]
  disciplineRecords    DisciplineRecord[]

  totpSecret           String?
  isTotpEnabled        Boolean        @default(false)

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  lastLoginAt          DateTime?
  emailVerified        DateTime?

  @@index([house])
}

model VerificationToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

model RefreshToken {
  id          String   @id @default(uuid())
  hashedToken String   @unique
  familyId    String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isRevoked   Boolean  @default(false)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
}

model LeaderboardSnapshot {
  id           String   @id @default(uuid())
  termName     String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  house        House
  points       Int
  rankInHouse  Int
  rankOverall  Int
  snapshotDate DateTime @default(now())
}

model ProfileLink {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       Provider
  externalHandle String
  verified       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@unique([userId, provider])
}

model ProfileSync {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     Provider
  rawSnapshot  Json
  parsedStats  Json
  lastSyncedAt DateTime  @default(now())
  lastError    String?
  status       String    @default("PENDING")

  @@unique([userId, provider])
}

model Certificate {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String   @default("")
  fileKey    String   @unique
  mimeType   String
  status     String   @default("PENDING_VERIFICATION")
  reviewedBy String?
  order      Int      @default(0)
  createdAt  DateTime @default(now())
}

enum Provider {
  GITHUB
  CODEFORCES
  LEETCODE
  GFG
  HTB
  THM
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum House {
  RED
  BLUE
  GREEN
  PURPLE
}

enum OpportunityType {
  BUG_BOUNTY
  HACKATHON
  CTF
  INTERNSHIP
  WORKSHOP
  CERT_DISCOUNT
  OTHER
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
}

model HouseTransferRequest {
  id           String         @id @default(uuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentHouse House
  targetHouse  House
  reason       String
  status       TransferStatus @default(PENDING)
  reviewedBy   String?
  reviewNotes  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  PUBLISHED
  REJECTED
}

enum ComplaintCategory {
  GRADING
  HARASSMENT
  PLATFORM_BUG
  OTHER
}

model Complaint {
  id           String            @id @default(uuid())
  trackingCode String            @unique
  category     ComplaintCategory
  content      String
  status       ComplaintStatus   @default(SUBMITTED)
  reportedDay  String
  adminNotes   String?
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}

model PointsTransaction {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta         Int
  reason        String
  referenceType String?  
  referenceId   String?  
  createdBy     String?  
  createdAt     DateTime @default(now())
}

model PerkItem {
  id                String       @id @default(uuid())
  name              String
  description       String?
  cost              Int
  quantityRemaining Int?         
  redemptions       Redemption[]
  isActive          Boolean      @default(true)
}

model Redemption {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  perkItemId     String
  perkItem       PerkItem         @relation(fields: [perkItemId], references: [id])
  idempotencyKey String
  createdAt      DateTime         @default(now())

  @@unique([userId, idempotencyKey])
}

model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  imageUrl    String?
  users       UserBadge[]
  createdAt   DateTime    @default(now())
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  awardedBy String?  // ID of the admin who manually awarded it (if applicable)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

enum AchievementCategory {
  HACKATHON
  CTF
  COMPETITION
  PUBLICATION
  OTHER
  // Framework specific
  SKILL_BADGES
  CERTIFICATION
  CYBER_RANGE
  SOC_CSIRT
  RESEARCH
  INNOVATION
  INDUSTRY_ENGAGEMENT
  OPEN_SOURCE_COMMUNITY
  KNOWLEDGE_SHARING
  LEADERSHIP_MENTORING
  LEARNING_PARTICIPATION
}

enum AchievementStatus {
  PENDING_VERIFICATION
  APPROVED
  REJECTED
}

model Achievement {
  id            String              @id @default(uuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  category      AchievementCategory
  position      String
  date          DateTime
  semester      String?
  prize         String?
  description   String?
  status        AchievementStatus   @default(PENDING_VERIFICATION)
  reviewedBy    String?
  pointsAwarded Int?
  opportunityId String?
  rubricId      String?
  rubric        PointsRubric?       @relation(fields: [rubricId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, userId])
}

model WorkExperience {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  role        String
  duration    String
  description String?
  isCurrent   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Opportunity {
  id           String               @id @default(uuid())
  title        String
  description  String
  externalUrl  String
  type         OpportunityType
  targetHouses House[]
  deadline     DateTime?
  isActive     Boolean              @default(true)
  postedById   String
  postedBy     User                 @relation("PostedOpportunities", fields: [postedById], references: [id])
  bookmarks    OpportunityBookmark[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([isActive])
}

model OpportunityBookmark {
  id                 String      @id @default(uuid())
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunityId      String
  opportunity        Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  lookingForTeammate Boolean     @default(false)
  createdAt          DateTime    @default(now())

  @@unique([userId, opportunityId])
  @@index([opportunityId])
}

model PointsRubric {
  id            String              @id @default(uuid())
  category      AchievementCategory
  activityKey   String              @unique
  description   String
  points        Int
  isBonus       Boolean             @default(false)
  capPerTerm    Int?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  achievements  Achievement[]
}



model DisciplineRecord {
  id             String              @id @default(uuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  violation      String
  pointsDeducted Int
  evidence       String?
  reportedBy     String
  termName       String?
  createdAt      DateTime            @default(now())
}

model HousePoints {
  id            String              @id @default(uuid())
  house         House
  termName      String
  category      AchievementCategory
  earnedPoints  Int                 @default(0)
  weightedScore Float               @default(0)
  updatedAt     DateTime            @updatedAt

  @@unique([house, termName, category])
}
