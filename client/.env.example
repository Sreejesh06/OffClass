# Vite Build-Time Environment Variables
# These variables are baked into the static client bundle during 'vite build'

# Polygon Amoy Testnet RPC endpoint (default public RPC provided)
VITE_POLYGON_RPC_URL="https://rpc-amoy.polygon.technology"

# Deployed CryptidRegistry smart contract address (update after running hardhat deploy)
VITE_ANCHOR_CONTRACT_ADDRESS="0x0000000000000000000000000000000000000000"
