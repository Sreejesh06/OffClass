# ==============================================================
# CRYPTID: PRODUCTION ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the secure values before
# running `docker compose up -d` on the college server.
# ==============================================================

# --- Application Security ---
# Generate a strong 64+ character random string for production
JWT_SECRET="generate_a_very_long_random_string_here"

# --- Database Credentials ---
POSTGRES_PASSWORD="secure_postgres_admin_password_here"
# The password for the application's limited DB user
APP_DB_PASSWORD="secure_app_user_password_here"

# --- Redis Configuration ---
REDIS_PASSWORD="secure_redis_password_here"

# --- Object Storage (MinIO) ---
MINIO_ACCESS_KEY="cryptid_minio_admin"
MINIO_SECRET_KEY="secure_minio_password_here"

# --- External API Integrations ---
# HackTheBox department-level App Token (for syncing student ranks)
HTB_APP_TOKEN=""

# --- Email Settings (For Password Reset / Verification) ---
# If left blank, the app will auto-generate an Ethereal Email 
# preview link in the logs, but users won't get actual emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# --- Domain & Reverse Proxy Settings ---
# Domain name for Caddy and email links (e.g., cryptid.sece.ac.in or 172.16.5.40:80)
DOMAIN="cryptid.sece.ac.in"
FRONTEND_URL="https://cryptid.sece.ac.in"
CLIENT_URL="https://cryptid.sece.ac.in"

# --- Blockchain Anchoring (Polygon Amoy Testnet) ---
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
BLOCKCHAIN_PRIVATE_KEY=""
CRYPTID_REGISTRY_ADDRESS=""

